# Copy to .env and load it (set -a; . ./.env; set +a) before `make dev-api`.
DATABASE_URL=postgres://offcut:offcut@localhost:5432/offcut?sslmode=disable
# 16+ random characters. Encrypts stored API keys; changing it makes them unreadable.
APP_SECRET=change-me-to-something-long-and-random
DATA_DIR=./data
PORT=8080
