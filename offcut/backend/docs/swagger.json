    },
    "basePath": "/api",
    "paths": {
        "/photos/{id}": {
            "get": {
                "produces": [
                    "image/jpeg",
                    "image/png",
                    "image/webp",
                    "image/gif"
                ],
                "tags": [
                    "photos"
                ],
                "summary": "Get a photo's image",
                "operationId": "getPhoto",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Photo id",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "file"
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "$ref": "#/definitions/ErrorResponse"
                        }
                    }
                }
            },
            "delete": {
                "tags": [
                    "photos"
                ],
                "summary": "Delete a photo the AI hasn't seen yet",
                "operationId": "deletePhoto",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Photo id",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "204": {
                        "description": "No Content"
                    },
                    "409": {
                        "description": "Conflict",
                        "schema": {
                            "$ref": "#/definitions/ErrorResponse"
                        }
                    }
                }
            }
        },
        "/projects": {
            "get": {
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "projects"
                ],
