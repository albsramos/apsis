        "/projects/{id}": {
            "get": {
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "projects"
                ],
                "summary": "Get a project with its photos, latest spec and what the AI is waiting on",
                "operationId": "getProject",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Project id",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
