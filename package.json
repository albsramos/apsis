{
  "name": "apsis",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Mission control for Kestrel Orbital's data centers in space.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "sim:check": "esbuild scripts/sim-check.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/sim-check.mjs --log-level=warning && node node_modules/.cache/sim-check.mjs -v",
    "build:pages": "tsc -b && vite build --mode pages --base ./ --outDir dist-pages",
    "build:artifact": "tsc -b && vite build --mode artifact --base ./ --outDir dist-artifact && node scripts/artifact.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@react-three/postprocessing": "^3.2.2",
    "cmdk": "^1.1.1",
    "postprocessing": "^6.39.6",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "three": "^0.187.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.2.1",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.6"
  }
}
